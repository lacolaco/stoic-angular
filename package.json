{
  "name": "eslint-plugin-stoic-angular",
  "version": "0.0.0",
  "description": "ESLint plugin that enforces stoic Angular design conventions",
  "license": "MIT",
  "author": "Suguru Inatomi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacolaco/stoic-angular.git"
  },
  "keywords": ["eslint", "eslintplugin", "eslint-plugin", "angular"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:english": "node scripts/check-english.mjs",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@eslint-community/eslint-utils": "^4.10.1",
    "@typescript-eslint/utils": "^8.67.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.9.0 <7.0.0"
  },
  "devDependencies": {
    "@angular/core": "^22.1.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/rule-tester": "^8.67.0",
    "eslint": "^10.6.0",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
