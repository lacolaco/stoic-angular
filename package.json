{
  "name": "eslint-plugin-stoic-angular",
  "version": "1.0.0",
  "description": "ESLint plugin that imposes strict design constraints on Angular code, with rules drawn from Five Lines of Code",
  "license": "MIT",
  "author": "Suguru Inatomi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacolaco/stoic-angular.git"
  },
  "homepage": "https://github.com/lacolaco/stoic-angular#readme",
  "bugs": {
    "url": "https://github.com/lacolaco/stoic-angular/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "angular",
    "oxlint",
    "lint",
    "five-lines-of-code"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:english": "node scripts/check-english.mjs",
    "test": "vitest run",
    "docs:generate": "pnpm build && eslint-doc-generator",
    "docs:check": "pnpm build && eslint-doc-generator --check"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@eslint-community/eslint-utils": "^4.10.1",
    "@typescript-eslint/utils": "^8.67.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/rule-tester": "^8.67.0",
    "eslint": "^10.6.0",
    "eslint-doc-generator": "^3.7.1",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
