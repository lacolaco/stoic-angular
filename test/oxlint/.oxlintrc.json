{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [{ "name": "stoic-angular", "specifier": "../../dist/index.js" }],
  "rules": {
    "stoic-angular/call-or-pass": "error",
    "stoic-angular/if-only-at-start": "error",
    "stoic-angular/max-function-lines": "error",
    "stoic-angular/no-else": "error",
    "stoic-angular/no-switch": "error",
    "stoic-angular/pure-conditions": "error",
    "stoic-angular/no-class-inheritance": "error",
    "stoic-angular/no-common-affixes": "error",
    "stoic-angular/max-directory-entries": "error",
    "stoic-angular/vm-signature": "error",
    "stoic-angular/inline-short-templates": "error"
  }
}
